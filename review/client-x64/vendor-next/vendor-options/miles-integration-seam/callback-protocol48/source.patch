+       r.value[0]!=parent.kind || r.value[1]!=parent.slot || r.value[2]!=parent.generation ||
+       (!nullHandle(r.resource) && r.resource.kind!=MilesWire::BorrowedSample))return false;
+    alias=r.resource;return true;
+}
