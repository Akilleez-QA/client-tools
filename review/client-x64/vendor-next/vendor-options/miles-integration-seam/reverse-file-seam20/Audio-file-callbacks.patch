+ClientAudioFileCallbacks::OpenResult ClientAudioFileCallbacks::open(char const *fileName)
+{
+	UINTa nativeHandle = 0;
+	OpenResult result;
+	result.callbackResult = static_cast<uint32_t>(fileOpenCallBack(fileName, &nativeHandle));
+	result.handle.value = static_cast<uintptr_t>(nativeHandle);
+	return result;
+}
+
+void ClientAudioFileCallbacks::close(LocalFileHandle const handle)
+{
+	fileCloseCallBack(static_cast<UINTa>(handle.value));
+}
+
+int32_t ClientAudioFileCallbacks::seek(LocalFileHandle const handle, int32_t const offset, uint32_t const origin)
+{
+	return static_cast<int32_t>(fileSeekCallBack(static_cast<UINTa>(handle.value),
+		static_cast<S32>(offset), static_cast<U32>(origin)));
+}
+
+uint32_t ClientAudioFileCallbacks::read(LocalFileHandle const handle, void *destination, uint32_t const requestedBytes)
+{
+	return static_cast<uint32_t>(fileReadCallBack(static_cast<UINTa>(handle.value),
+		destination, static_cast<U32>(requestedBytes)));
+}
