+	return result;
+}
+
+void ClientAudioFileCallbacks::close(LocalFileHandle const handle)
+{
+	fileCloseCommon(static_cast<UINTa>(handle.value));
+}
+
+int32_t ClientAudioFileCallbacks::seek(LocalFileHandle const handle, int32_t const offset, uint32_t const origin)
+{
+	return static_cast<int32_t>(fileSeekCommon(static_cast<UINTa>(handle.value),
+		static_cast<S32>(offset), static_cast<U32>(origin)));
+}
+
+uint32_t ClientAudioFileCallbacks::read(LocalFileHandle const handle, void *destination, uint32_t const requestedBytes)
+{
+	return static_cast<uint32_t>(fileReadCommon(static_cast<UINTa>(handle.value),
+		destination, static_cast<U32>(requestedBytes)));
