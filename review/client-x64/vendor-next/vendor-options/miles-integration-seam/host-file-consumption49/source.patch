+#include "file_tokens.h"
+namespace MilesHostFiles49 {
+namespace {
+bool same(const MilesWire::Handle &a,const MilesWire::Handle &b) {
+    return a.kind==b.kind && a.slot==b.slot && a.generation==b.generation;
+}
